{
  "name": "gypaete-admin",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "api:clean": "node -e \"require('fs').rmSync('src/app/openapi', { recursive: true, force: true })\"",
    "api:generate": "openapi-generator-cli generate -c openapi.config.json",
    "api:regen": "npm run api:clean && npm run api:generate"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@10.9.3",
  "overrides": {
    "basic-ftp": "^6.2.3"
  },
  "dependencies": {
    "@angular/cdk": "^21.0.5",
    "@angular/common": "^22.2.2",
    "@angular/compiler": "^22.2.2",
    "@angular/core": "^22.2.2",
    "@angular/forms": "^22.2.2",
    "@angular/material": "^21.0.5",
    "@angular/platform-browser": "^22.2.2",
    "@angular/router": "^22.2.2",
    "ngx-cookie-service": "^22.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "^0.16.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.2",
    "@angular/cli": "^22.2.2",
    "@angular/compiler-cli": "^22.2.2",
    "@openapitools/openapi-generator-cli": "^2.41.0",
    "jsdom": "^27.1.0",
    "typescript": "~6.0.3",
    "vitest": "^4.0.8"
  }
}
